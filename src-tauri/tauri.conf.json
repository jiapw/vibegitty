{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeGitty",
  "version": "0.3.1",
  "identifier": "com.artsq.vibegitty",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VibeGitty",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#15181e"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "VibeGitty - Git client",
    "longDescription": "Cross-platform Git client with a built-in git engine, Git LFS support, GitHub OAuth and third-party git server accounts.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": { "deb": { "depends": [] } },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
